rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRoleDoc() {
      return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    function getRoleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }

    // Admin check — checks email allowlist, auth claim, or server-granted role doc.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in ['ezra@readyaimgo.biz'] ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (hasRoleDoc() && getRoleDoc().role == 'admin')
      );
    }

    // Cohort Manager check — admin or cohort-manager role.
    function isCohortManager() {
      return signedIn() && (
        isAdmin() ||
        request.auth.token.role == 'cohort-manager' ||
        (hasRoleDoc() && getRoleDoc().role == 'cohort-manager')
      );
    }

    // Verified Professional check by subtype (general-contractor, underwriter, attorney, surveyor, architect).
    function isVerifiedProfessional(subtype) {
      return signedIn() && (
        isAdmin() ||
        (request.auth.token.role == 'verified-professional' && request.auth.token.subtype == subtype) ||
        (hasRoleDoc() && getRoleDoc().role == 'verified-professional' && getRoleDoc().subtype == subtype)
      );
    }

    // User Roles & Credentials (server grant read/write).
    match /userRoles/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Asset Interest Inquiries — DEFECT FIX (a):
    // Any signed-in user can submit an inquiry; read/update/delete restricted to admin/cohort-manager.
    match /assetInterest/{inquiryId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin() || isCohortManager();
    }

    // Properties — DEFECT FIX (b):
    // Public assets are readable by anyone; non-public assets (publicVisible != true)
    // require admin or cohort-manager authorization. "Signed-in" alone is no longer sufficient.
    match /beamAssets/{assetId} {
      allow read: if resource.data.publicVisible == true || isAdmin() || isCohortManager();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Public site suggestions: anyone may submit; only admins can read/manage.
    match /siteSuggestions/{suggestionId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.suggestedBy.name is string
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // City registry: anyone can read (used for public labels/filters); any
    // signed-in participant can add a city; only admins edit/delete existing.
    match /cities/{cityId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Neighborhood donations: anyone signed in may record one; admins read/manage.
    match /donations/{donationId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // Public facilities testimony: anyone may submit; only admins may review or manage.
    match /groundsTestimonies/{testimonyId} {
      allow create: if request.resource.data.responses is map
        && request.resource.data.discipline in ['music', 'visual-arts', 'engineering', 'general']
        && request.resource.data.consentLevel in [
          'private-grounds-only',
          'partner-review-anonymized',
          'public-anonymized',
          'public-attributed',
        ]
        && request.resource.data.hasDocumentation is bool
        && request.resource.data.mode in ['self', 'interview']
        && request.resource.data.keys().hasAll([
          'responses',
          'discipline',
          'consentLevel',
          'hasDocumentation',
          'mode',
          'createdAt',
        ])
        && request.resource.data.keys().hasOnly([
          'responses',
          'discipline',
          'consentLevel',
          'hasDocumentation',
          'contact',
          'mode',
          'enteredBy',
          'createdAt',
        ])
        && (!('contact' in request.resource.data) || request.resource.data.contact is string)
        && (!('enteredBy' in request.resource.data) || request.resource.data.enteredBy == 'ezra');
      allow read, update, delete: if isAdmin();
    }

    // Members may read memberships and write only their own.
    match /memberships/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Redevelopment Projects & Subcollections:
    // Published projects readable by anyone; unpublished require admin/cohort-manager.
    match /redevelopmentProjects/{projectId} {
      allow read: if resource.data.isPublished == true || isAdmin() || isCohortManager();
      allow write: if isAdmin() || isCohortManager();

      match /{sub=**} {
        allow read: if resource.data.isPublished == true || isAdmin() || isCohortManager();
        allow write: if isAdmin() || isCohortManager();
      }
    }

    // Catch-all: signed-in read for default collections, admin-only write.
    match /{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
